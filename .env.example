# PETER PAN — environment template
# Copy to .env for local use. Never commit real secrets or live resource IDs.

# --- Runtime mode ---
# test | local | aws-demo
PETER_RUNTIME_MODE=local

# --- Shared service auth (required for any network-exposed deploy) ---
PETER_SERVICES_TOKEN=
PETER_WEBHOOK_SECRET=

# --- Docker Compose service URLs (host ports in local profile) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/peter-signal
# Local HTTP only — allows bootstrap REST session over compose network
N8N_SECURE_COOKIE=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENCRYPTION_KEY=
N8N_JWT_SECRET=
N8N_OWNER_EMAIL=admin@local.peter
N8N_OWNER_PASSWORD=
PETER_GUARDRAILS_URL=http://localhost:8004
PETER_PREDICTOR_URL=http://localhost:8002
PETER_RAG_URL=http://localhost:8003
PETER_LANGGRAPH_URL=http://localhost:8006
PETER_TOOLS_URL=http://localhost:8005
PETER_FIXTURE_LLM_URL=http://localhost:8010/v1
# n8n uses PETER_SERVICES_TOKEN for the local fixture OpenAI credential.
PETER_REVIEW_QUEUE_URL=http://localhost:8020/review-queue
PETER_SLACK_STUB_URL=http://localhost:8020/slack
PETER_GITHUB_STUB_URL=http://localhost:8020/github/deployments

# --- Team routing stubs (Stage A) ---
PETER_DB_TEAM_WEBHOOK=http://localhost:8020/teams/database
PETER_INFRA_TEAM_WEBHOOK=http://localhost:8020/teams/infra
PETER_APP_TEAM_WEBHOOK=http://localhost:8020/teams/application
PETER_TRIAGE_TEAM_WEBHOOK=http://localhost:8020/teams/triage

# --- Tools API ---
TOOLS_AUDIT_DB=./var/audit.sqlite
PETER_ENABLE_LIVE_DISPATCH=false
PETER_NOTIFICATION_ALLOWLIST=

# --- Layer 4 providers (Stage C — disabled by default) ---
PETER_LLM_PROVIDER=fixture
AWS_REGION=us-east-1
AWS_PROFILE=
# Optional Stage C only; read-only account audit confirmed this model is authorized.
PETER_BEDROCK_AGENT_MODEL=anthropic.claude-sonnet-4-6
PETER_GEMINI_EXTRACT_MODEL=gemini-2.5-flash
PETER_LLAMACPP_URL=
PETER_OLLAMA_URL=http://localhost:11434

# --- Vector store (Stage C — optional) ---
PETER_VECTOR_BACKEND=tfidf
CHROMA_PATH=./services/rag/data/chroma
PETER_PGVECTOR_URL=
PETER_SUPABASE_URL=
PETER_SUPABASE_KEY=

# --- RAG generation (Stage C — optional; fixture-first demo never depends on this) ---
GGUF_MODEL_PATH=

# --- Grafana / Dashboard Generator ---
GRAFANA_URL=http://localhost:3000
GRAFANA_API_TOKEN=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PROMETHEUS_UID=
PETER_DASHBOARD_GENERATOR_URL=http://localhost:8008

# --- UI ---
PETER_UI_N8N_WEBHOOK_URL=http://localhost:5678/webhook/peter-signal

# --- Cursor MCP (optional n8n instance-level connector) ---
N8N_MCP_URL=
N8N_MCP_TOKEN=
