{
  "$defs": {
    "DeployRef": {
      "additionalProperties": false,
      "properties": {
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "sha": {
          "title": "Sha",
          "type": "string"
        },
        "deployed_at": {
          "format": "date-time",
          "title": "Deployed At",
          "type": "string"
        },
        "service": {
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "sha",
        "deployed_at",
        "service"
      ],
      "title": "DeployRef",
      "type": "object"
    },
    "IncidentContext": {
      "additionalProperties": false,
      "description": "Output of the n8n context-enrichment branches (nodes MW/DEP/CMP \u2192 merge).",
      "properties": {
        "maintenance_window": {
          "default": false,
          "title": "Maintenance Window",
          "type": "boolean"
        },
        "recent_deploys": {
          "items": {
            "$ref": "#/$defs/DeployRef"
          },
          "title": "Recent Deploys",
          "type": "array"
        },
        "complaint_count": {
          "default": 0,
          "title": "Complaint Count",
          "type": "integer"
        },
        "complaint_samples": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Complaint Samples",
          "type": "array"
        }
      },
      "title": "IncidentContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A draft or confirmed incident flowing through n8n into the agent.",
  "properties": {
    "id": {
      "pattern": "^inc-[a-z0-9-]{8,}$",
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "triaging",
        "suppressed",
        "rejected",
        "triaged",
        "review"
      ],
      "title": "Status",
      "type": "string"
    },
    "signal_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Signal Ids",
      "type": "array"
    },
    "service": {
      "title": "Service",
      "type": "string"
    },
    "environment": {
      "title": "Environment",
      "type": "string"
    },
    "p_level": {
      "anyOf": [
        {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P Level"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "symptom": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Symptom",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/IncidentContext"
    }
  },
  "required": [
    "id",
    "created_at",
    "status",
    "signal_ids",
    "service",
    "environment",
    "symptom"
  ],
  "title": "Incident",
  "type": "object"
}
