flowchart LR
    subgraph DEMO["Demo Environment · local · Docker Compose + k3d"]
        LOAD["Load + Chaos Injector<br/>k6 traffic · pod kill · memory leak · DB locks"]:::demo
        APPS["Demo microservices on k3d<br/>shop-web · orders-api · PostgreSQL"]:::demo
        OTEL["OpenTelemetry Collector"]:::demo
        PROM["Prometheus — metrics"]:::demo
        LOKI["Loki — logs"]:::demo
        GRAF["Grafana OSS<br/>dashboards + alert rules"]:::demo
        LOAD --> APPS --> OTEL
        OTEL --> PROM
        OTEL --> LOKI
        PROM --> GRAF
        LOKI --> GRAF
    end

    subgraph CORE["PETER PAN Core · AWS EC2 · Docker Compose"]
        ING["Ingestion API<br/>FastAPI POST /signals"]:::core
        PRED["Predictive Engine<br/>EWMA floor + PyTorch classifier"]:::core
        RAG["RAG Service<br/>cited answers only"]:::core
        GRD["Guardrails Service<br/>NeMo + regex floor"]:::core
        LG["LangGraph Agent<br/>Planner → Specialists → Synthesiser"]:::core
        TOOLS["Tools API + Approval Gate<br/>owners · deploys · escalation · audit log"]:::core
    end

    N8N["n8n Orchestration<br/>the PETER flow"]:::n8n

    subgraph AI["AI Models — routed by task"]
        FIX["Stage A FixtureLM<br/>OpenAI-compatible · deterministic"]:::ai
        BR["Optional Stage C · Amazon Bedrock<br/>Claude Sonnet — agents & synthesis"]:::ai
        GEM["Optional Stage C · Gemini 2.5 Flash<br/>information extraction"]:::ai
        LCPP["Optional Stage C · Llama.cpp on EC2<br/>Mistral 7B GGUF — RAG generation"]:::ai
        OLL["Optional Stage C · Ollama local<br/>Llama 3 — WebUI · Hermes — OpenClaw"]:::ai
    end

    subgraph KNOW["Knowledge & Change"]
        CONF["Confluence Free<br/>runbooks + ownership docs"]:::know
        PGV["Supabase pgvector<br/>vector store"]:::know
        GH["GitHub<br/>repo · Actions CI evals · deploy events"]:::know
    end

    subgraph HUM["Humans & Comms"]
        UI["Streamlit WebUI<br/>fixture assistant + incident form<br/>optional Stage C Ollama"]:::hum
        SLK["Slack<br/>incident channels · complaint reader"]:::hum
        OC["OpenClaw + Hermes<br/>Telegram approvals from the phone"]:::hum
    end

    GRAF -->|alert webhook| ING
